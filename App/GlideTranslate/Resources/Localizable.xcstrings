{
  "sourceLanguage": "en",
  "strings": {
    "about.licenses.localNotices": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-source license notices are bundled locally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源许可声明已随应用保存在本地。"
          }
        }
      }
    },
    "about.privacy.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glide Translate processes text only after an explicit action and keeps private data under your control."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻译仅在你明确操作后处理文本，私密数据始终由你掌控。"
          }
        }
      }
    },
    "about.releases": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Releases" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "版本发布" } }
      }
    },
    "about.source": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Source Code" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "源代码" } }
      }
    },
    "about.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "app.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glide Translate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻译"
          }
        }
      }
    },
    "app.startup.failed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Glide Translate could not start" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "轻译无法启动" } }
      }
    },
    "app.startup.failure.corruptPreferences": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Preferences could not be loaded safely. Automatic capture remains stopped." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法安全载入偏好设置。自动取词保持停止。" } }
      }
    },
    "app.startup.failure.historyMaintenanceFailure": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "History maintenance is unavailable. Manual translation remains available." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "历史维护暂不可用。手动翻译仍可使用。" } }
      }
    },
    "app.startup.failure.captureUnavailable": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Selection capture is unavailable. Automatic capture remains stopped." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择取词暂不可用。自动取词保持停止。" } }
      }
    },
    "app.startup.failure.partialShutdown": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Some resources could not be closed safely." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "部分资源未能安全关闭。" } }
      }
    },
    "app.startup.failure.providerVaultRecoveryRequired": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Provider storage requires recovery. Automatic capture remains stopped." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "模型服务存储需要恢复。自动取词保持停止。" } }
      }
    },
    "app.startup.failure.shortcutConflict": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The saved shortcut is unavailable. Choose a replacement in Settings." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已保存的快捷键不可用。请在设置中选择替代快捷键。" } }
      }
    },
    "app.startup.loading": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Starting Glide Translate…" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在启动轻译…" } }
      }
    },
    "common.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "common.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "common.save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "error.onboarding.explanationRequired.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Review the privacy explanation before continuing." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "继续前请先查看隐私说明。" } }
      }
    },
    "error.onboarding.explanationRequired.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Read this step, then continue or skip." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "阅读此步骤，然后继续或跳过。" } }
      }
    },
    "error.onboarding.invalidModel.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The model name is invalid." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "模型名称无效。" } }
      }
    },
    "error.onboarding.invalidModel.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enter a nonempty model name within 256 characters." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请输入不超过 256 个字符的非空模型名称。" } }
      }
    },
    "error.onboarding.persistenceFailed.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Onboarding progress could not be saved." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法保存新手引导进度。" } }
      }
    },
    "error.onboarding.persistenceFailed.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check storage availability, then try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查存储是否可用，然后重试。" } }
      }
    },
    "error.onboarding.providerUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The local model service is unavailable." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "本地模型服务不可用。" } }
      }
    },
    "error.onboarding.providerUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Start the service, load its model list, and choose a model." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "启动服务，获取模型列表并选择一个模型。" } }
      }
    },
    "error.onboarding.shortcutUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The shortcut could not be registered." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "快捷键无法注册。" } }
      }
    },
    "error.onboarding.shortcutUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose one of the replacement shortcuts." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请选择一个替代快捷键。" } }
      }
    },
    "error.settings.diagnosticsUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The diagnostic report could not be prepared." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法准备诊断报告。" } }
      }
    },
    "error.settings.diagnosticsUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Try exporting the report again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请重新尝试导出报告。" } }
      }
    },
    "error.settings.historyUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "History is unavailable." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "历史记录不可用。" } }
      }
    },
    "error.settings.historyUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Retry, or use the recovery action if history is damaged." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请重试；若历史已损坏，请使用恢复操作。" } }
      }
    },
    "error.settings.invalidValue.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "That value is not supported." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "该值不受支持。" } }
      }
    },
    "error.settings.invalidValue.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enter a value within the displayed limits." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请输入界面所示范围内的值。" } }
      }
    },
    "error.settings.launchAtLoginUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Launch at login could not be changed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法更改登录时启动。" } }
      }
    },
    "error.settings.launchAtLoginUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Review system login-item settings, then try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查系统登录项设置，然后重试。" } }
      }
    },
    "error.settings.persistenceFailed.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Settings could not be saved." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "设置无法保存。" } }
      }
    },
    "error.settings.persistenceFailed.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check storage availability, then try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查存储是否可用，然后重试。" } }
      }
    },
    "error.settings.promptReplacementRequired.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A replacement default prompt is required." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "需要替换默认提示词。" } }
      }
    },
    "error.settings.promptReplacementRequired.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose another prompt before deleting the current default." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除当前默认项前，请选择另一个提示词。" } }
      }
    },
    "error.settings.promptUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The prompt action could not be completed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法完成提示词操作。" } }
      }
    },
    "error.settings.promptUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Review the prompt and try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查提示词，然后重试。" } }
      }
    },
    "error.settings.providerUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The provider action could not be completed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法完成模型服务操作。" } }
      }
    },
    "error.settings.providerUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check the provider configuration and availability, then retry." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查模型服务配置和可用性，然后重试。" } }
      }
    },
    "error.settings.missingModel.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No model is selected for this provider." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此提供商尚未选择模型。" } }
      }
    },
    "error.settings.missingModel.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Load the available models, then choose one to use." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "获取可用模型列表，然后选择要使用的模型。" } }
      }
    },
    "error.settings.destinationConfirmationRequired.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This model needs to reconnect to its API service." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此模型需要重新连接 API 服务。" } }
      }
    },
    "error.settings.destinationConfirmationRequired.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open the model, load its available models again, then choose one to use." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开该配置，重新获取模型列表，然后选择要使用的模型。" } }
      }
    },
    "error.settings.credentialRejected.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The provider rejected its credential." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "提供商拒绝了凭据。" } }
      }
    },
    "error.settings.credentialRejected.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Replace the credential, then test the connection again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "替换凭据，然后重新测试连接。" } }
      }
    },
    "error.settings.providerFailure.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The provider returned an error." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "提供商返回了错误。" } }
      }
    },
    "error.settings.providerFailure.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Review the provider settings and try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查提供商设置，然后重试。" } }
      }
    },
    "error.settings.resetIncomplete.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Some reset stages did not complete." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "部分重置步骤未完成。" } }
      }
    },
    "error.settings.resetIncomplete.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Review the reported stages before retrying." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查报告中的步骤后再重试。" } }
      }
    },
    "error.settings.runtimeRefreshUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The app could not rebuild its private runtime after reset." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "重置后无法重建应用的私有运行环境。" } }
      }
    },
    "error.settings.runtimeRefreshUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Restart the app before continuing." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请先重新启动应用再继续。" } }
      }
    },
    "error.settings.selectionEffectUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The selection setting could not be applied." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法应用划词设置。" } }
      }
    },
    "error.settings.selectionEffectUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Review Accessibility permission, then try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查辅助功能权限，然后重试。" } }
      }
    },
    "error.settings.shortcutUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The shortcut could not be registered." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "快捷键无法注册。" } }
      }
    },
    "error.settings.shortcutUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose another shortcut, then try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择其他快捷键，然后重试。" } }
      }
    },
    "error.translation.accessibilityPermissionMissing.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Accessibility permission is required for selected-text capture." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "划词捕获需要辅助功能权限。" } }
      }
    },
    "error.translation.accessibilityPermissionMissing.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open Accessibility settings, or use manual translation." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开辅助功能设置，或使用手动翻译。" } }
      }
    },
    "error.translation.applicationExcluded.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "History is excluded for this application." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此应用已被排除在历史记录之外。" } }
      }
    },
    "error.translation.applicationExcluded.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Review History exclusions in Settings if you want to store future results." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "如需存储后续结果，请在设置中检查历史记录排除项。" } }
      }
    },
    "error.translation.applicationNotAllowed.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Automatic capture is not allowed for this application." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此应用不允许自动捕获。" } }
      }
    },
    "error.translation.automaticCapturePaused.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Automatic selection capture is paused or disabled." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "自动划词捕获已暂停或停用。" } }
      }
    },
    "error.translation.automaticCapturePaused.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Resume automatic capture in Settings, or use the explicit shortcut." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在设置中恢复自动捕获，或使用显式快捷键。" } }
      }
    },
    "error.translation.applicationNotAllowed.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Allow the application in Settings, or translate manually." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在设置中允许该应用，或手动翻译。" } }
      }
    },
    "error.translation.cancelled.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The translation was cancelled." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "翻译已取消。" } }
      }
    },
    "error.translation.cancelled.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Start a new translation when ready." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "准备好后可重新发起翻译。" } }
      }
    },
    "error.translation.connectionTimeout.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The provider connection timed out." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "连接模型服务超时。" } }
      }
    },
    "error.translation.connectionTimeout.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check the provider and network, then retry." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查模型服务和网络，然后重试。" } }
      }
    },
    "error.translation.credentialStoreUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The credential store is unavailable." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "凭据存储不可用。" } }
      }
    },
    "error.translation.credentialStoreUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Unlock the Mac, then retry without exposing the credential." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "解锁 Mac 后重试；应用不会显示凭据。" } }
      }
    },
    "error.translation.destinationReconfirmationRequired.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The model's API connection has changed or expired." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "模型的 API 连接已变更或失效。" } }
      }
    },
    "error.translation.destinationReconfirmationRequired.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open Models, reconnect the service, and choose a model to use." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开“模型”，重新连接服务并选择要使用的模型。" } }
      }
    },
    "error.translation.firstTokenTimeout.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The model did not begin responding in time." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "模型未能及时开始响应。" } }
      }
    },
    "error.translation.firstTokenTimeout.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Retry, or increase the first-token timeout." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请重试，或提高首个词元超时时间。" } }
      }
    },
    "error.translation.historyUnrecoverable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Encrypted history cannot be recovered." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "加密历史记录无法恢复。" } }
      }
    },
    "error.translation.historyUnrecoverable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use the history recovery action in Settings." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请在设置中使用历史恢复操作。" } }
      }
    },
    "error.translation.historyDisabled.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Translation history is disabled." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "翻译历史记录已停用。" } }
      }
    },
    "error.translation.historyDisabled.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enable History in Settings only if you want future results stored." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "仅当你希望存储后续结果时，才在设置中启用历史记录。" } }
      }
    },
    "error.translation.invalidCredential.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The provider credential was rejected." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "模型服务凭据被拒绝。" } }
      }
    },
    "error.translation.invalidCredential.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Replace the credential in Settings, then retry." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在设置中替换凭据，然后重试。" } }
      }
    },
    "error.translation.invalidProviderConfiguration.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The provider configuration is incomplete." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "模型服务配置不完整。" } }
      }
    },
    "error.translation.invalidProviderConfiguration.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Review the endpoint, model, and default provider." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查端点、模型和默认模型服务。" } }
      }
    },
    "error.translation.modelUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The selected model is unavailable." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "所选模型不可用。" } }
      }
    },
    "error.translation.modelUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Load or select an available model, then retry." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "加载或选择可用模型，然后重试。" } }
      }
    },
    "error.translation.noValidSelection.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No valid selected text was found." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "未找到有效的选中文本。" } }
      }
    },
    "error.translation.noValidSelection.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Select text again, or use manual translation." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请重新选择文本，或使用手动翻译。" } }
      }
    },
    "error.translation.offDeviceApplicationNotAllowed.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This application is not authorized to send selected text off device." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此应用未获授权将选中文本发送到设备外。" } }
      }
    },
    "error.translation.offDeviceApplicationNotAllowed.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Allow this application to send selected text to the configured API address, or use manual translation." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "允许此应用将选中文本发送到已配置的 API 地址，或改用手动翻译。" } }
      }
    },
    "error.translation.ollamaUnavailable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ollama is unavailable." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Ollama 不可用。" } }
      }
    },
    "error.translation.ollamaUnavailable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Start Ollama, then retry or choose another provider." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "启动 Ollama 后重试，或选择其他模型服务。" } }
      }
    },
    "error.translation.preferencesUnrecoverable.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Preferences cannot be recovered." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "偏好设置无法恢复。" } }
      }
    },
    "error.translation.preferencesUnrecoverable.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Reset private data or restart the app." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "重置私有数据，或重新启动应用。" } }
      }
    },
    "error.translation.providerProtocolFailure.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The provider returned an invalid response." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "模型服务返回了无效响应。" } }
      }
    },
    "error.translation.providerProtocolFailure.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check protocol compatibility, then retry." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查协议兼容性，然后重试。" } }
      }
    },
    "error.translation.providerRecoveryRequired.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The provider store requires recovery." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "模型服务存储需要恢复。" } }
      }
    },
    "error.translation.providerRecoveryRequired.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open Models settings and repair or recreate the provider." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开“模型”设置，修复或重新创建模型服务。" } }
      }
    },
    "error.translation.streamIdleTimeout.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The response stream became idle." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "响应流长时间无数据。" } }
      }
    },
    "error.translation.streamIdleTimeout.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Retry, or increase the stream-idle timeout." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请重试，或提高流空闲超时时间。" } }
      }
    },
    "error.translation.unsafeFallbackState.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The safe selection fallback is unavailable." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "安全的划词备用方式不可用。" } }
      }
    },
    "error.translation.unsafeFallbackState.nextAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use manual translation without granting clipboard access." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请使用无需剪贴板权限的手动翻译。" } }
      }
    },
    "error.translation.unsupportedApplication.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This application does not support safe selection capture." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此应用不支持安全的划词捕获。" } }
      }
    },
    "error.translation.unsupportedApplication.nextAction": {
